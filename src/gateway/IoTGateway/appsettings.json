{
  "Jwt": {
    "Issuer": "IoT.Api",
    "Audience": "IoT.Client",
    "ExpiresInMinutes": 60
  },
  "Services": {
    "DeviceService": "http://device-service"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "monolith-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "monolith-route": {
        "ClusterId": "monolith-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "telemetry-route": {
        "ClusterId": "telemetry-cluster",
        "Match": {
          "Path": "/api/telemetry/{**catch-all}"
        }
      },
      "device-route": {
        "ClusterId": "device-cluster",
        "Match": {
          "Path": "/api/devices/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "maintenance-route": {
        "ClusterId": "maintenance-cluster",
        "Match": {
          "Path": "/api/devices/{deviceId}/maintenance/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "alerts-route": {
        "ClusterId": "device-cluster",
        "Match": {
          "Path": "/api/alerts/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "rules-route": {
        "ClusterId": "device-cluster",
        "Match": {
          "Path": "/api/rules/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "monolith-cluster": {
        "Destinations": {
          "monolith": {
            "Address": "http://iot-api"
          }
        }
      },
      "telemetry-cluster": {
        "Destinations": {
          "telemetry": {
            "Address": "http://telemetry-service"
          }
        }
      },
      "device-cluster": {
        "Destinations": {
          "device": {
            "Address": "http://device-service"
          }
        }
      },
      "maintenance-cluster": {
        "Destinations": {
          "maintenance": {
            "Address": "http://maintenance-service"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}